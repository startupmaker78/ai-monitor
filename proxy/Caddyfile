{
    admin off
    auto_https off
}

:8080 {
    # Access-лог: метод/путь/статус/длительность. Тела Caddy не логирует
    # никогда; секретные заголовки (Authorization=ключ OpenRouter,
    # X-Proxy-Auth=наш токен) вырезаем фильтром — в лог не попадут.
    log {
        output stderr
        format filter {
            wrap console
            request>headers>Authorization delete
            request>headers>X-Proxy-Auth delete
        }
    }

    # Health-чек для Fly LB — без auth, дешёвый 200. Fly бьёт /healthz и
    # убирает нездоровую машину из ротации (иначе слал бы трафик вслепую).
    @health path /healthz
    handle @health {
        respond "ok" 200
    }

    # Гейт X-Proxy-Auth: нет/неверный → свой 403 с отличимым заголовком.
    @noauth not header X-Proxy-Auth "{$PROXY_AUTH}"
    handle @noauth {
        header X-Webmon-Proxy "reject-auth"
        respond `{"error":"proxy_auth_failed","source":"webmon-proxy"}` 403
    }

    @chat path /api/v1/chat/completions
    handle @chat {
        reverse_proxy https://openrouter.ai {
            header_up Host openrouter.ai
            header_up -X-Proxy-Auth
            transport http {
                read_timeout 180s
                dial_timeout 10s
            }
        }
    }

    handle {
        respond 404
    }
}
